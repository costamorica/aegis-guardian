[Unit]
Description=Aegis Guardian modular healthcheck
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root

ExecStart=/opt/aegis-guardian/bin/aegis-guardian

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=10m

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-guardian
